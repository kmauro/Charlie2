APP_NAME="Clínica"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_LOCALE=es_AR
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

SUPERADMIN_NAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=charlie2
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
EXTERNAL_CLINICAL_RECORD_URL=https://historia-clinica.example.test
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

DOCKER_APP_ENV=local
DOCKER_APP_DEBUG=true
DOCKER_APP_URL=http://localhost:8080
DOCKER_APP_PORT=8080
DOCKER_DB_DATABASE=charlie2
DOCKER_DB_USERNAME=charlie2
DOCKER_DB_PASSWORD=charlie2
DOCKER_DB_ROOT_PASSWORD=root
DOCKER_DB_PORT=3307
DOCKER_MAIL_MAILER=smtp
DOCKER_MAIL_SCHEME=
DOCKER_MAIL_HOST=mailpit
DOCKER_MAIL_PORT=1025
DOCKER_MAIL_USERNAME=
DOCKER_MAIL_PASSWORD=
DOCKER_MAIL_FROM_ADDRESS=no-reply@charlie2.local
DOCKER_MAILPIT_PORT=8025

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
